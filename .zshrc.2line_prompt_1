# Need to include .zshrc.bash_prompt

PROMPT1_1=$'\n%{\e[32m%}%n@%m %{\e[33m%}%~%{\e[0m%}'
PROMPT1_2=$'%(!.#.$) '

# VCSの情報を取得するzshの便利関数 vcs_infoを使う
autoload -Uz vcs_info

vcs_info 2>/dev/null
if [ $? -eq 0 ]; then

  # 表示フォーマットの指定
  # %b ブランチ情報
  # %a アクション名(mergeなど)
  zstyle ':vcs_info:*' formats '[%b]'
  zstyle ':vcs_info:*' actionformats '[%b|%a]'
  precmd () {
      psvar=()
      LANG=en_US.UTF-8 vcs_info
      [[ -n "$vcs_info_msg_0_" ]] && psvar[1]="$vcs_info_msg_0_"
  }

  PROMPT1_1=${PROMPT1_1}$' %1(v|%F{green}%1v%f|)'
fi

PROMPT=${PROMPT1_1}$'\n'${PROMPT1_2}
PROMPT2="%{${fg[blue]}%}%_> %{${reset_color}%}"
RPROMPT=""
