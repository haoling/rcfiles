#!/bin/sh
# rcfiles の機能を選んで、インストール・アンインストールする
#
#   rcfiles-setup                     画面で選ぶ（↑↓ で移動、Space で切り替え、Enter で決定）
#   rcfiles-setup list                各機能の状態を表示する
#   rcfiles-setup install <機能>...   指定した機能をインストールする
#   rcfiles-setup uninstall <機能>... 指定した機能をアンインストールする
#   rcfiles-setup defaults            標準の機能をインストールする（ln_rcfiles.sh から呼ばれる）
#
# 機能は setup.d/<名前>.yml に1ファイルずつ書く（形式は setup.d/README.md）。
# ファイルを足すだけで、一覧に出るようになる。
# YAML は rcfiles-setup.awk で読むので、書けるのは README.md に書いた形だけ。
#
# 何度実行しても大丈夫です。POSIX sh で書いているので、macOS でも Linux でも動きます。

RCDIR=$(cd "$(dirname "$0")" && pwd)
SETUPD=$RCDIR/setup.d
AWKFILE=$RCDIR/rcfiles-setup.awk
cd "$HOME" || exit 1

# ホームに置くリンクの指し先。~/.rcfiles にあるときは、相対パスにする
if [ "$RCDIR" = "$HOME/.rcfiles" ]; then
	LINK_BASE=.rcfiles
else
	LINK_BASE=$RCDIR
fi

if [ -t 1 ]; then
	C_ON=$(printf '\033[32m'); C_PART=$(printf '\033[33m'); C_DIM=$(printf '\033[2m')
	C_BOLD=$(printf '\033[1m'); C_REV=$(printf '\033[7m'); C_RST=$(printf '\033[0m')
else
	C_ON=; C_PART=; C_DIM=; C_BOLD=; C_REV=; C_RST=
fi

# setup.d/*.yml の install / uninstall / status に書いたシェルからも使える
msg() { printf '  %s\n' "$*"; }
warn() { printf '  %s! %s%s\n' "$C_PART" "$*" "$C_RST"; }

# 読み込み中に見つけた問題（YAML の書き間違いなど）
WARNINGS=
add_warning() { WARNINGS="$WARNINGS$*
"; }
show_warnings() {
	[ -n "$WARNINGS" ] || return 0
	printf '%s' "$WARNINGS" | while IFS= read -r l; do warn "$l"; done
	WARNINGS=
}

# ---------------------------------------------------------------------------
# リンク

# usage: link_state <置き場所> <リポジトリ内のパス>
# 0: rcfiles へのリンクになっている / 1: なっていない
link_state() {
	[ -L "$1" ] || return 1
	case "$(readlink "$1")" in
		*.rcfiles/"$2" | "$RCDIR/$2") return 0 ;;
	esac
	return 1
}

# usage: link_target <置き場所> <リポジトリ内のパス>  リンクの指し先を表示する
link_target() {
	if [ "$LINK_BASE" = .rcfiles ]; then
		rest=$1; up=
		while :; do
			case $rest in
				*/*) up=$up../; rest=${rest#*/} ;;
				*) break ;;
			esac
		done
		echo "$up$LINK_BASE/$2"
	else
		echo "$RCDIR/$2"
	fi
}

# usage: link_install <置き場所> <リンクの指し先> <リポジトリ内のパス>
# 同じ名前の実体ファイルがあれば <置き場所>.rcfiles-bak に退避する
link_install() {
	if link_state "$1" "$3" && [ "$(readlink "$1")" = "$2" ]; then
		return 0
	elif [ -L "$1" ]; then
		rm "$1"
	elif [ -e "$1" ]; then
		bak=$1.rcfiles-bak
		[ -e "$bak" ] && bak=$1.rcfiles-bak.$(date +%Y%m%d%H%M%S)
		mv "$1" "$bak" && msg "既存の ~/$1 を ~/$bak に退避しました"
	fi
	d=$(dirname "$1")
	[ -d "$d" ] || mkdir -p "$d"
	ln -s "$2" "$1" && msg "リンク: ~/$1 -> $2"
}

# usage: link_uninstall <置き場所> <リポジトリ内のパス>
# rcfiles へのリンクだけを消す。退避したファイルがあれば戻す
link_uninstall() {
	if link_state "$1" "$2"; then
		rm "$1" && msg "削除: ~/$1"
		if [ -e "$1.rcfiles-bak" ] && [ ! -e "$1" ]; then
			mv "$1.rcfiles-bak" "$1" && msg "退避していた ~/$1.rcfiles-bak を戻しました"
		fi
	elif [ -e "$1" ] || [ -L "$1" ]; then
		warn "~/$1 は rcfiles のリンクではないので、そのままにします"
	fi
}

# link: のリスト1行を L_DEST（置き場所）と L_SRC（リポジトリ内のパス）に分ける
#   ".vimrc"                           -> 同じ名前
#   ".gnupg/x.py: gnupg/x.py"          -> 置き場所: リポジトリ内のパス
split_link() {
	case $1 in
		*': '*) L_DEST=${1%%: *}; L_SRC=${1#*: } ;;
		*) L_DEST=$1; L_SRC=$1 ;;
	esac
}

# リンクの数と、リンク済みの数を「数 数」の形で表示する
link_units() {
	n=0; ok=0
	while IFS= read -r item; do
		[ -n "$item" ] || continue
		split_link "$item"
		n=$((n + 1))
		link_state "$L_DEST" "$L_SRC" && ok=$((ok + 1))
	done <<EOF
$y_link
EOF
	echo "$n $ok"
}

# ---------------------------------------------------------------------------
# ファイルへの行の追加・削除（file / where / marker / text）

# usage: write_file <ファイル> < 新しい内容
# 権限やリンク元を変えないように、上書きで書き戻す
write_file() {
	tmp=$1.rcfiles-tmp.$$
	cat > "$tmp" && cat "$tmp" > "$1"
	rm -f "$tmp"
}

text_present() { grep -qsF -- "$y_marker" "$y_file"; }

text_install() {
	text_present && return 0
	if [ -L "$y_file" ]; then
		case "$(readlink "$y_file")" in
			*.rcfiles/* | "$RCDIR"/*) rm "$y_file" ;;
			*) warn "~/$y_file は別の場所へのリンクなので、変更しません"; return 0 ;;
		esac
	fi
	if [ "$y_where" = bottom ]; then
		# 末尾が改行で終わっていなければ足してから追加する
		if [ -s "$y_file" ] && [ -n "$(tail -c 1 "$y_file")" ]; then printf '\n' >> "$y_file"; fi
		printf '%s\n' "$y_text" >> "$y_file" && msg "~/$y_file の最後に追加しました"
	else
		{
			printf '%s\n' "$y_text"
			if [ -f "$y_file" ]; then cat "$y_file"; fi
		} | write_file "$y_file" && msg "~/$y_file の先頭に追加しました"
	fi
}

# text と同じ行が並んでいるところを消す
text_uninstall() {
	[ -f "$y_file" ] || return 0
	text_present || return 0
	RC_TEXT=$y_text awk '
		BEGIN { n = split(ENVIRON["RC_TEXT"], t, "\n") }
		{ line[NR] = $0 }
		END {
			for (i = 1; i <= NR; i++) {
				m = (i + n - 1 <= NR)
				for (j = 1; m && j <= n; j++) if (line[i + j - 1] != t[j]) m = 0
				if (m) { i += n - 1; continue }
				print line[i]
			}
		}' "$y_file" | write_file "$y_file"
	if text_present; then
		warn "~/$y_file に「$y_marker」を含む行が残っています。手で消してください"
	else
		msg "~/$y_file から削除しました"
	fi
}

# ---------------------------------------------------------------------------
# 機能の読み込み

# setup.d/*.yml のファイル名（.yml を除く）を IDS に入れる
scan() {
	IDS=
	for f in "$SETUPD"/*.yml; do
		[ -f "$f" ] || continue
		id=${f##*/}; id=${id%.yml}
		case $id in
			*[!A-Za-z0-9._-]*) add_warning "setup.d/$id.yml: 名前に使えるのは英数字と . _ - だけです。飛ばします"; continue ;;
		esac
		IDS="$IDS $id"
	done
}

# usage: load <名前>  setup.d/<名前>.yml を y_* の変数に読み込む
load() {
	y_description= y_default= y_os= y_requires_dir= y_link= y_file= y_where= y_marker=
	y_text= y_status= y_install= y_uninstall= y_warn=
	[ -f "$SETUPD/$1.yml" ] || return 1
	out=$(awk -f "$AWKFILE" "$SETUPD/$1.yml") || { add_warning "setup.d/$1.yml: 読めませんでした"; return 1; }
	eval "$out"
	if [ -n "$y_warn" ]; then
		while IFS= read -r l; do add_warning "setup.d/$1.yml: $l"; done <<EOF
$y_warn
EOF
	fi
	[ -n "$y_where" ] || y_where=top
	case $y_where in
		top | bottom) ;;
		*) add_warning "setup.d/$1.yml: where は top か bottom です（$y_where）。top として扱います"; y_where=top ;;
	esac
	if [ -n "$y_text" ] && [ -z "$y_file" ]; then
		add_warning "setup.d/$1.yml: text には file が必要です。text は使いません"
		y_text=
	fi
	if [ -n "$y_text" ] && [ -z "$y_marker" ]; then
		y_marker=$(printf '%s\n' "$y_text" | head -n 1)
	fi
	return 0
}

# 読み込み済みの機能の状態を表示する: on / off / partial / na（この環境では使えない）
module_status() {
	if [ -n "$y_os" ] && [ "$(uname -s | tr 'A-Z' 'a-z')" != "$y_os" ]; then echo na; return; fi
	if [ -n "$y_requires_dir" ] && [ ! -d "$y_requires_dir" ]; then echo na; return; fi
	if [ -n "$y_status" ]; then
		s=$(eval "$y_status")
		case $s in on | off | partial) echo "$s" ;; *) echo off ;; esac
		return
	fi
	units=$(link_units); n=${units% *}; ok=${units#* }
	if [ -n "$y_text" ]; then
		n=$((n + 1))
		text_present && ok=$((ok + 1))
	fi
	if [ "$n" -eq 0 ] || [ "$ok" -eq 0 ]; then echo off
	elif [ "$ok" -eq "$n" ]; then echo on
	else echo partial
	fi
}

is_module() { [ -f "$SETUPD/$1.yml" ]; }

state_label() {
	case $1 in
		on) printf '%sインストール済み%s' "$C_ON" "$C_RST" ;;
		partial) printf '%s一部だけ%s' "$C_PART" "$C_RST" ;;
		off) printf '未インストール' ;;
		na) printf '%sこの環境では使えません%s' "$C_DIM" "$C_RST" ;;
	esac
}

do_install() {
	load "$1" || return 1
	printf '%s[インストール] %s%s\n' "$C_BOLD" "$1" "$C_RST"
	while IFS= read -r item; do
		[ -n "$item" ] || continue
		split_link "$item"
		link_install "$L_DEST" "$(link_target "$L_DEST" "$L_SRC")" "$L_SRC"
	done <<EOF
$y_link
EOF
	[ -n "$y_text" ] && text_install
	[ -n "$y_install" ] && eval "$y_install"
	return 0
}

do_uninstall() {
	load "$1" || return 1
	printf '%s[アンインストール] %s%s\n' "$C_BOLD" "$1" "$C_RST"
	while IFS= read -r item; do
		[ -n "$item" ] || continue
		split_link "$item"
		link_uninstall "$L_DEST" "$L_SRC"
	done <<EOF
$y_link
EOF
	[ -n "$y_text" ] && text_uninstall
	[ -n "$y_uninstall" ] && eval "$y_uninstall"
	return 0
}

# ---------------------------------------------------------------------------
# コマンド

cmd_list() {
	scan
	for id in $IDS; do
		load "$id" || continue
		def=; [ "$y_default" = true ] && def="  ${C_DIM}[標準]${C_RST}"
		printf '  %-18s %s%s\n' "$id" "$(state_label "$(module_status)")" "$def"
		printf '  %-18s %s%s%s\n' "" "$C_DIM" "$y_description" "$C_RST"
	done
	show_warnings
}

# usage: cmd_apply install|uninstall <機能>...
cmd_apply() {
	action=$1; shift
	[ $# -gt 0 ] || { echo "機能の名前を指定してください（rcfiles-setup list で一覧）" >&2; return 1; }
	for id in "$@"; do
		is_module "$id" || { echo "そのような機能はありません: $id（rcfiles-setup list で一覧）" >&2; return 1; }
	done
	for id in "$@"; do
		load "$id" || continue
		if [ "$(module_status)" = na ]; then
			warn "$id はこの環境では使えないので、飛ばします"
			continue
		fi
		"do_$action" "$id"
	done
	show_warnings
}

# default: true の機能をインストールする
cmd_defaults() {
	scan
	for id in $IDS; do
		load "$id" || continue
		[ "$y_default" = true ] || continue
		[ "$(module_status)" = na ] && continue
		do_install "$id"
	done
	show_warnings
}

# ---------------------------------------------------------------------------
# 画面で選ぶ

TTY_SAVED=
restore_tty() {
	[ -n "$TTY_SAVED" ] && stty "$TTY_SAVED" </dev/tty
	TTY_SAVED=
	printf '\033[?25h' >/dev/tty
}

# 1 キー読んで KEY に入れる: up down space enter quit か、その文字
read_key() {
	c=$(dd bs=1 count=1 2>/dev/null </dev/tty)
	case $c in
		"$(printf '\033')")
			stty min 0 time 1 </dev/tty
			rest=$(dd bs=1 count=2 2>/dev/null </dev/tty)
			stty min 1 time 0 </dev/tty
			case $rest in
				'[A' | OA) KEY=up ;;
				'[B' | OB) KEY=down ;;
				'') KEY=quit ;;
				*) KEY= ;;
			esac ;;
		'') KEY=enter ;;
		' ') KEY=space ;;
		k) KEY=up ;;
		j) KEY=down ;;
		q | Q) KEY=quit ;;
		*) KEY=$c ;;
	esac
}

# 画面の項目は番号（1 から total）で持つ: id_N, desc_N, st_N（今の状態）, sel_N（1: 入れる / 0: 入れない）
draw_menu() {
	printf '\033[H\033[2J'
	printf '%srcfiles の機能を選んでください%s  %s(%s)%s\n\n' "$C_BOLD" "$C_RST" "$C_DIM" "$SETUPD" "$C_RST"
	i=0
	while [ $i -lt $total ]; do
		i=$((i + 1))
		eval "id=\$id_$i st=\$st_$i sel=\$sel_$i"
		if [ "$st" = na ]; then box='   '
		elif [ "$sel" = 1 ]; then box='[x]'
		else box='[ ]'
		fi
		# 変わるところに印を付ける
		mark=' '
		if [ "$st" != na ]; then
			if [ "$sel" = 1 ] && [ "$st" != on ]; then mark="${C_ON}+${C_RST}"
			elif [ "$sel" = 0 ] && [ "$st" != off ]; then mark="${C_PART}-${C_RST}"
			fi
		fi
		if [ $i -le 9 ]; then num=$i; else num=' '; fi
		line=$(printf '%s %s %-18s' "$num" "$box" "$id")
		if [ $i -eq "$cur" ]; then
			printf ' %s %s%s%s  %s\n' "$mark" "$C_REV" "$line" "$C_RST" "$(state_label "$st")"
		else
			printf ' %s %s  %s\n' "$mark" "$line" "$(state_label "$st")"
		fi
	done
	eval "desc=\$desc_$cur"
	printf '\n  %s%s%s\n\n' "$C_DIM" "$desc" "$C_RST"
	printf '  ↑↓/jk: 移動  Space/数字(1-9): 切り替え  a: 全部選ぶ  n: 全部外す  r: 元に戻す\n'
	printf '  Enter: 決定  q: やめる\n'
	printf '  %s+%s インストールする  %s-%s アンインストールする\n' "$C_ON" "$C_RST" "$C_PART" "$C_RST"
}

toggle() {
	eval "st=\$st_$1 sel=\$sel_$1"
	[ "$st" = na ] && return
	if [ "$sel" = 1 ]; then eval "sel_$1=0"; else eval "sel_$1=1"; fi
}

# usage: select_all 1|0 | select_current  全部選ぶ / 全部外す / 今の状態に戻す
select_all() {
	i=0
	while [ $i -lt $total ]; do
		i=$((i + 1))
		eval "st=\$st_$i"
		[ "$st" = na ] && continue
		eval "sel_$i=$1"
	done
}
select_current() {
	i=0
	while [ $i -lt $total ]; do
		i=$((i + 1))
		eval "st=\$st_$i"
		case $st in on | partial) eval "sel_$i=1" ;; *) eval "sel_$i=0" ;; esac
	done
}

cmd_interactive() {
	if [ ! -t 0 ] || [ ! -t 1 ]; then
		echo "端末から実行してください。スクリプトから使うときは install / uninstall を指定します" >&2
		usage >&2
		return 1
	fi
	scan
	total=0
	for id in $IDS; do
		load "$id" || continue
		total=$((total + 1))
		st=$(module_status)
		eval "id_$total=\$id desc_$total=\$y_description st_$total=\$st"
	done
	if [ $total -eq 0 ]; then
		show_warnings
		echo "$SETUPD に機能がありません（*.yml を置いてください）" >&2
		return 1
	fi
	if [ -n "$WARNINGS" ]; then
		show_warnings
		printf '\nEnter で続行 '
		read -r _ </dev/tty
	fi
	select_current
	cur=1

	TTY_SAVED=$(stty -g </dev/tty)
	trap 'restore_tty' EXIT
	trap 'restore_tty; exit 130' INT TERM
	stty -icanon -echo min 1 time 0 </dev/tty
	printf '\033[?25l'

	while :; do
		draw_menu
		read_key
		case $KEY in
			up) cur=$((cur - 1)); [ $cur -lt 1 ] && cur=$total ;;
			down) cur=$((cur + 1)); [ $cur -gt $total ] && cur=1 ;;
			space) toggle $cur ;;
			[1-9]) [ "$KEY" -le $total ] && { cur=$KEY; toggle $cur; } ;;
			a) select_all 1 ;;
			n) select_all 0 ;;
			r) select_current ;;
			enter) break ;;
			quit) restore_tty; printf '\033[H\033[2J'; echo "何もしませんでした"; return 0 ;;
		esac
	done
	restore_tty
	printf '\033[H\033[2J'

	to_install=; to_uninstall=
	i=0
	while [ $i -lt $total ]; do
		i=$((i + 1))
		eval "id=\$id_$i st=\$st_$i sel=\$sel_$i"
		[ "$st" = na ] && continue
		if [ "$sel" = 1 ] && [ "$st" != on ]; then to_install="$to_install $id"
		elif [ "$sel" = 0 ] && [ "$st" != off ]; then to_uninstall="$to_uninstall $id"
		fi
	done
	if [ -z "$to_install$to_uninstall" ]; then
		echo "変更はありません"
		return 0
	fi

	echo "次の変更をします:"
	for id in $to_install; do printf '  %s+ インストール%s     %s\n' "$C_ON" "$C_RST" "$id"; done
	for id in $to_uninstall; do printf '  %s- アンインストール%s %s\n' "$C_PART" "$C_RST" "$id"; done
	printf '\nよろしいですか? [y/N] '
	read -r ans </dev/tty
	case $ans in y | Y | yes) ;; *) echo "やめました"; return 0 ;; esac
	echo
	for id in $to_uninstall; do do_uninstall "$id"; done
	for id in $to_install; do do_install "$id"; done
	show_warnings
	echo
	echo "完了しました。zsh の設定を変えたときは、新しいシェルを開くと反映されます"
}

usage() {
	cat <<'EOF'
使い方:
  rcfiles-setup                     画面で選んでインストール・アンインストールする
  rcfiles-setup list                各機能の状態を表示する
  rcfiles-setup install <機能>...   指定した機能をインストールする
  rcfiles-setup uninstall <機能>... 指定した機能をアンインストールする
  rcfiles-setup defaults            標準の機能をまとめてインストールする

機能は setup.d/<名前>.yml です。ファイルを足すと一覧に出ます（形式は setup.d/README.md）
EOF
}

case $1 in
	'') cmd_interactive ;;
	list | ls | -l | --list) cmd_list ;;
	install | -i | --install) shift; cmd_apply install "$@" ;;
	uninstall | remove | -u | --uninstall) shift; cmd_apply uninstall "$@" ;;
	defaults | --defaults) cmd_defaults ;;
	help | -h | --help) usage ;;
	*) echo "不明なコマンドです: $1" >&2; usage >&2; exit 1 ;;
esac
